# Configurações do Servidor
PORT=3001
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bi_crepaldi
DB_USER=postgres
DB_PASSWORD=sua-senha-aqui
DB_POOL_SIZE=10

# Sincronização (a cada X minutos)
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=5
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY_MS=5000

# Bitrix24 API Configuration
BITRIX24_WEBHOOK_URL=https://seu-dominio.bitrix24.com.br/rest/1/seu-webhook/
BITRIX24_DOMAIN=seu-dominio.bitrix24.com.br

# Belle Software API Configuration
BELLE_API_URL=https://app.bellesoftware.com.br/api/release/controller/IntegracaoExterna/v1.0
BELLE_API_TOKEN=seu-token-aqui
BELLE_ESTABELECIMENTOS=1,2,5,10,11,12,14

# Cache Configuration (em segundos)
CACHE_TTL=300

# CORS
FRONTEND_URL=http://localhost:5173
